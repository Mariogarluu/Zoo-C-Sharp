<Window x:Class="zoo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="500" Width="800" Background="White">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Lista de Zoos" Grid.Column="0" Grid.Row="0" Margin="0,0,0,5"/>
        <ListBox x:Name="ListaZoos" Grid.Column="0" Grid.Row="1" Margin="5"
                 DisplayMemberPath="Ubicacion" SelectedValuePath="Id"
                 SelectionChanged="ListaZoos_SelectionChanged"/>

        <Button x:Name="btnBorrarZoo" Content="Eliminar Zoo" Grid.Column="0" Grid.Row="2" Margin="5" Height="25" Background="#DDDDDD" Click="BorrarZoo_Click"/>

        <TextBox x:Name="miTextBox" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" 
                 Height="30" Margin="5" BorderBrush="#5588FF" BorderThickness="2" VerticalContentAlignment="Center"/>

        <Button x:Name="btnAgregarZoo" Content="Agregar Zoo" Grid.Column="0" Grid.Row="4" Margin="5" Height="25" Background="#DDDDDD" Click="AgregarZoo_Click"/>
        <Button x:Name="btnActualizarZoo" Content="Actualizar Zoo" Grid.Column="0" Grid.Row="5" Margin="5" Height="25" Background="#DDDDDD" Click="ActualizarZoo_Click"/>


        <Label Content="Lista de animales asociados" Grid.Column="1" Grid.Row="0" Margin="0,0,0,5"/>
        <ListBox x:Name="ListaAnimalesAsociados" Grid.Column="1" Grid.Row="1" Margin="5"
                 DisplayMemberPath="Nombre" SelectedValuePath="Id"/>

        <Button x:Name="btnQuitarAnimal" Content="Quitar Animal" Grid.Column="1" Grid.Row="2" Margin="5" Height="25" Background="#DDDDDD" Click="QuitarAnimalZoo_Click"/>

        <Button x:Name="btnAgregarAnimalAZoo" Content="Agregar Animal al Zoo" Grid.Column="1" Grid.Row="4" Margin="5" Height="25" Background="#DDDDDD" Click="AgregarAnimalAZoo_Click"/>
        <Button x:Name="btnActualizarAnimal" Content="Actualizar Animal" Grid.Column="1" Grid.Row="5" Margin="5" Height="25" Background="#DDDDDD" Click="ActualizarAnimal_Click"/>


        <Button x:Name="btnAgregarAnimal" Content="Agregar animal al zoo" Grid.Column="2" Grid.Row="0" Margin="5" Height="25" Background="#DDDDDD" Click="AgregarAnimal_Click"/>

        <ListBox x:Name="ListaAnimales" Grid.Column="2" Grid.Row="1" Grid.RowSpan="4" Margin="5"
                 DisplayMemberPath="Nombre" SelectedValuePath="Id"
                 SelectionChanged="ListaAnimales_SelectionChanged"/>

        <Button x:Name="btnBorrarAnimal" Content="Eliminar animal" Grid.Column="2" Grid.Row="5" Margin="5" Height="25" Background="#DDDDDD" Click="BorrarAnimal_Click"/>

    </Grid>
</Window>